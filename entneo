<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Les mille et unes astuces de l'ENT</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

        .header h1 {
            font-size: 3rem;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            animation: fadeInDown 1s ease-out;
        }

        .header p {
            font-size: 1.2rem;
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.6;
            animation: fadeInUp 1s ease-out 0.3s both;
        }

        .section {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            animation: fadeInUp 0.8s ease-out;
        }

        .section h2 {
            color: #667eea;
            font-size: 2.2rem;
            margin-bottom: 30px;
            text-align: center;
            position: relative;
        }

        .section h2::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            border-radius: 2px;
        }

        .quiz-container {
            display: grid;
            gap: 20px;
        }

        .quiz-item {
            background: linear-gradient(135deg, #f8f9ff 0%, #e8f0ff 100%);
            border-radius: 15px;
            padding: 25px;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .quiz-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(102, 126, 234, 0.2);
            border-color: #667eea;
        }

        .quiz-question {
            font-size: 1.2rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
        }

        .quiz-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .option {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .option:hover {
            border-color: #667eea;
            background: #f8f9ff;
            transform: scale(1.02);
        }

        .option.correct {
            border-color: #4CAF50;
            background: #e8f5e8;
            animation: pulse 0.6s ease-in-out;
        }

        .option.incorrect {
            border-color: #f44336;
            background: #ffeaea;
            animation: shake 0.6s ease-in-out;
        }

        .feedback {
            margin-top: 15px;
            padding: 15px;
            border-radius: 10px;
            display: none;
        }

        .feedback.show {
            display: block;
            animation: fadeIn 0.5s ease-out;
        }

        .feedback.correct {
            background: #e8f5e8;
            color: #2e7d32;
            border-left: 4px solid #4CAF50;
        }

        .feedback.incorrect {
            background: #ffeaea;
            color: #c62828;
            border-left: 4px solid #f44336;
        }

        .resources-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-top: 30px;
        }

        .resource-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            transition: all 0.4s ease;
            border: 2px solid transparent;
            cursor: pointer;
        }

        .resource-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
            border-color: #667eea;
        }

        .resource-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }

        .resource-card h3 {
            color: #333;
            font-size: 1.4rem;
            margin-bottom: 15px;
        }

        .resource-card p {
            color: #666;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .resource-link {
            display: inline-block;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            padding: 12px 25px;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .resource-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .special-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 25px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 10px 5px;
        }

        .special-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .progress-bar {
            background: #e0e0e0;
            height: 8px;
            border-radius: 4px;
            margin: 30px 0;
            overflow: hidden;
        }

        .progress-fill {
            background: linear-gradient(45deg, #667eea, #764ba2);
            height: 100%;
            width: 0%;
            transition: width 0.8s ease;
        }

        .score {
            text-align: center;
            font-size: 1.2rem;
            color: #667eea;
            font-weight: 600;
            margin-bottom: 20px;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 2rem;
            }
            
            .quiz-options {
                grid-template-columns: 1fr;
            }
            
            .resources-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎯 Les mille et unes astuces de l'ENT</h1>
            <p>L'ENT est un espace numérique de travail sécurisé permettant un travail collaboratif au niveau de toute la communauté scolaire. Il met l'accent sur l'aspect collaboratif en limitant les barrières techniques. Il propose aussi des ressources et des applications de qualité que vous allez découvrir de façon interactive.</p>
        </div>

        <div class="section">
            <h2>🚀 Applications de l'ENT Néo</h2>
            <div style="text-align: center; margin-bottom: 25px;">
                <a href="https://neointhepocket.glideapp.io/" target="_blank" class="special-link" style="background: linear-gradient(45deg, #667eea, #764ba2); color: white; box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);">
                    <span style="font-size: 1.5rem;">📱</span>
                    Découvrir l'app Neo in the Pocket
                </a>
            </div>
            <div class="score">Score: <span id="score">0</span>/3</div>
            <div class="progress-bar">
                <div class="progress-fill" id="progress"></div>
            </div>
            
            <div class="quiz-container">
                <div class="quiz-item" data-question="1">
                    <div class="quiz-question">
                        <div class="icon">🎙️</div>
                        Quelle application permet d'enregistrer des messages vocaux ?
                    </div>
                    <div class="quiz-options">
                        <div class="option" data-answer="correct">Dictaphone</div>
                        <div class="option" data-answer="incorrect">Blog</div>
                        <div class="option" data-answer="incorrect">Mur collaboratif</div>
                    </div>
                    <div class="feedback correct-feedback">
                        <strong>Correct !</strong> Le dictaphone permet d'enregistrer facilement des messages vocaux pour enrichir vos contenus pédagogiques.
                    </div>
                    <div class="feedback incorrect-feedback">
                        <strong>Incorrect !</strong> La bonne réponse est le Dictaphone. Cette application permet d'enregistrer facilement des messages vocaux.
                    </div>
                </div>

                <div class="quiz-item" data-question="2">
                    <div class="quiz-question">
                        <div class="icon">📌</div>
                        Quelle application ressemble à un Padlet pour la collaboration ?
                    </div>
                    <div class="quiz-options">
                        <div class="option" data-answer="incorrect">Dictaphone</div>
                        <div class="option" data-answer="correct">Mur collaboratif</div>
                        <div class="option" data-answer="incorrect">Blog</div>
                    </div>
                    <div class="feedback correct-feedback">
                        <strong>Excellent !</strong> Le mur collaboratif fonctionne comme un Padlet et permet à tous de contribuer facilement à un projet commun.
                    </div>
                    <div class="feedback incorrect-feedback">
                        <strong>Incorrect !</strong> La bonne réponse est le Mur collaboratif. Cette application ressemble à un Padlet pour la collaboration.
                    </div>
                </div>

                <div class="quiz-item" data-question="3">
                    <div class="quiz-question">
                        <div class="icon">✈️</div>
                        Quelle application est idéale pour documenter les voyages scolaires avec likes et commentaires ?
                    </div>
                    <div class="quiz-options">
                        <div class="option" data-answer="incorrect">Mur collaboratif</div>
                        <div class="option" data-answer="incorrect">Dictaphone</div>
                        <div class="option" data-answer="correct">Blog</div>
                    </div>
                    <div class="feedback correct-feedback">
                        <strong>Parfait !</strong> Le blog est l'outil idéal pour raconter vos voyages scolaires avec la possibilité pour les lecteurs de liker et commenter.
                    </div>
                    <div class="feedback incorrect-feedback">
                        <strong>Incorrect !</strong> La bonne réponse est le Blog. Cette application permet de documenter les voyages avec likes et commentaires.
                    </div>
                </div>
            </div>
        </div>

        <div class="section">
            <h2>📚 Ressources de la région</h2>
            <div class="resources-grid">
                <div class="resource-card">
                    <div class="resource-icon">📖</div>
                    <h3>Magazine Focus Ressources</h3>
                    <p>Le magazine de la DANE de Lille qui présente toutes les ressources numériques disponibles dans l'académie. Guide complet pour découvrir les outils pédagogiques.</p>
                    <a href="https://dane.site.ac-lille.fr/2024/10/18/le-magazine-focus-ressources/" target="_blank" class="resource-link">Consulter</a>
                </div>
                <div class="resource-card">
                    <div class="resource-icon">📚</div>
                    <h3>Capeezy</h3>
                    <p>Plateforme de soutien scolaire en ligne des éditions Bordas. Exercices interactifs, cours et révisions pour tous les niveaux.</p>
                    <a href="https://www.editions-bordas.fr/capeezy-soutien-scolaire-en-ligne.html" target="_blank" class="resource-link">Découvrir</a>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">🔬</div>
                    <h3>EduMedia</h3>
                    <p>Ressources pédagogiques interactives en sciences. Animations, simulations et exercices pour comprendre les phénomènes scientifiques.</p>
                    <a href="https://www.edumedia.com/" target="_blank" class="resource-link">Explorer</a>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">🌍</div>
                    <h3>GlobalExam</h3>
                    <p>Préparation aux tests de langues internationaux. Entraînements et certifications pour TOEIC, TOEFL, IELTS et bien d'autres.</p>
                    <a href="https://global-exam.com/en" target="_blank" class="resource-link">S'entraîner</a>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">📚</div>
                    <h3>Encyclopædia Universalis</h3>
                    <p>Encyclopédie de référence avec des articles de qualité rédigés par des experts dans tous les domaines de la connaissance.</p>
                    <a href="https://www.universalis.fr/" target="_blank" class="resource-link">Consulter</a>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">📖</div>
                    <h3>Esidoc</h3>
                    <p>Portail documentaire du CDI. Recherche dans le catalogue, ressources numériques et actualités de la documentation.</p>
                    <a href="http://0595400z.esidoc.fr" target="_blank" class="resource-link">Accéder</a>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">🛡️</div>
                    <h3>Internet Sans Crainte</h3>
                    <p>Sensibilisation aux usages responsables d'Internet. Conseils, ressources et outils pour une navigation sécurisée.</p>
                    <a href="https://www.internetsanscrainte.fr/" target="_blank" class="resource-link">Apprendre</a>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">📰</div>
                    <h3>Madmagz</h3>
                    <p>Création de magazines numériques. Outil collaboratif pour réaliser des journaux scolaires et des projets éditoriaux.</p>
                    <a href="https://madmagz.com/fr/" target="_blank" class="resource-link">Créer</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        let score = 0;
        let questionsAnswered = 0;
        const totalQuestions = 3;

        document.querySelectorAll('.option').forEach(option => {
            option.addEventListener('click', function() {
                const quizItem = this.closest('.quiz-item');
                const allOptions = quizItem.querySelectorAll('.option');
                const isCorrect = this.dataset.answer === 'correct';
                
                // Vérifier si la question a déjà été répondue
                if (quizItem.classList.contains('answered')) {
                    return;
                }
                
                // Marquer la question comme répondue
                quizItem.classList.add('answered');
                
                // Désactiver tous les options
                allOptions.forEach(opt => {
                    opt.style.pointerEvents = 'none';
                    if (opt.dataset.answer === 'correct') {
                        opt.classList.add('correct');
                    } else if (opt === this && !isCorrect) {
                        opt.classList.add('incorrect');
                    }
                });

                // Sélectionner le bon feedback
                const correctFeedback = quizItem.querySelector('.correct-feedback');
                const incorrectFeedback = quizItem.querySelector('.incorrect-feedback');
                
                // Mettre à jour le score
                if (isCorrect) {
                    score++;
                    correctFeedback.classList.add('show', 'correct');
                } else {
                    incorrectFeedback.classList.add('show', 'incorrect');
                }

                questionsAnswered++;
                
                // Mettre à jour le score et la barre de progression
                document.getElementById('score').textContent = score;
                const progress = (questionsAnswered / totalQuestions) * 100;
                document.getElementById('progress').style.width = progress + '%';

                // Animation de célébration si toutes les questions sont bonnes
                if (questionsAnswered === totalQuestions && score === totalQuestions) {
                    setTimeout(() => {
                        alert('🎉 Félicitations ! Vous avez obtenu un score parfait ! Vous maîtrisez parfaitement les applications de l\'ENT Néo !');
                    }, 1000);
                }
            });
        });

        // Animation des cartes de ressources
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.resource-card').forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(50px)';
            card.style.transition = `all 0.6s ease ${index * 0.1}s`;
            observer.observe(card);
        });
    </script>
</body>
</html>
