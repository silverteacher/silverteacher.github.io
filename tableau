    <script>
        // Fonctionnalité du bouton Télécharger PDF
        const downloadBtn = document.getElementById('downloadPdfBtn');
        const dashboardContent = document.getElementById('dashboardContent');
        const { jsPDF } = window.jspdf; // Récupère jsPDF depuis l'objet global window

        downloadBtn.addEventListener('click', () => {
            console.log("Tentative de génération PDF...");
            // Ajouter une classe pour masquer le bouton pendant la capture
            document.body.classList.add('pdf-generating');

            html2canvas(dashboardContent, {
                 scale: 2, // Augmenter l'échelle pour une meilleure résolution
                 useCORS: true, // Si des images externes sont utilisées
                 logging: true, // Activer les logs de html2canvas pour le débogage
                 onclone: (document) => {
                    // Optionnel : ajustements sur le clone du DOM avant la capture
                 }
            }).then(canvas => {
                console.log("Canvas généré par html2canvas.");
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF({
                    orientation: 'p', // portrait
                    unit: 'mm', // millimètres
                    format: 'a4' // format A4
                });

                const imgProps= pdf.getImageProperties(imgData);
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = pdf.internal.pageSize.getHeight();

                // Calculer le ratio pour ajuster l'image à la largeur du PDF
                const imgWidth = pdfWidth - 20; // Largeur de l'image avec marges de 10mm
                const imgHeight = (imgProps.height * imgWidth) / imgProps.width;
                let heightLeft = imgHeight;

                let position = 10; // Marge supérieure initiale de 10mm

                // Ajouter l'image (potentiellement sur plusieurs pages)
                 pdf.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
                 heightLeft -= (pdfHeight - 20); // 20 pour marges haut/bas

                while (heightLeft > 0) {
                    position = heightLeft - imgHeight + 10; // Nouvelle position Y (négative)
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
                    heightLeft -= (pdfHeight - 20);
                }


                console.log("PDF généré, sauvegarde en cours...");
                pdf.save('tableau_de_bord_webinaires.pdf');

                 // Retirer la classe après la génération
                 document.body.classList.remove('pdf-generating');

            }).catch(error => {
                 console.error("Erreur lors de la génération du PDF:", error);
                 // Retirer la classe en cas d'erreur aussi
                 document.body.classList.remove('pdf-generating');
                 alert("Une erreur est survenue lors de la création du PDF.");
            });
        });
    </script>

</body>
