<script>
// Implémentation Data SDK avec localStorage pour GitHub Pages
window.dataSdk = {
    handler: null,

    async init(handler) {
        this.handler = handler;
        setTimeout(() => this.loadData(), 0);
        return { isOk: true };
    },

    loadData() {
        const data = JSON.parse(localStorage.getItem('webinarData') || '[]');
        if (this.handler && this.handler.onDataChanged) {
            this.handler.onDataChanged(data);
        }
    },

    async create(item) {
        const data = JSON.parse(localStorage.getItem('webinarData') || '[]');
        item.__backendId = item.id + '-' + Date.now();
        data.push(item);
        localStorage.setItem('webinarData', JSON.stringify(data));
        this.loadData();
        return { isOk: true };
    },

    async update(item) {
        const data = JSON.parse(localStorage.getItem('webinarData') || '[]');
        const index = data.findIndex(i => i.__backendId === item.__backendId);
        if (index !== -1) {
            data[index] = item;
            localStorage.setItem('webinarData', JSON.stringify(data));
            this.loadData();
            return { isOk: true };
        }
        return { isOk: false, error: 'Item not found' };
    },

    async delete(item) {
        const data = JSON.parse(localStorage.getItem('webinarData') || '[]');
        const filtered = data.filter(i => i.__backendId !== item.__backendId);
        localStorage.setItem('webinarData', JSON.stringify(filtered));
        this.loadData();
        return { isOk: true };
    }
};

// Implémentation Element SDK pour GitHub Pages
window.elementSdk = {
    config: {},

    async init(options) {
        this.config = options.defaultConfig || {};
        if (options.render) {
            options.render(this.config);
        }
        return { isOk: true };
    },

    setConfig(newConfig) {
        Object.assign(this.config, newConfig);
    }
};
</script>
