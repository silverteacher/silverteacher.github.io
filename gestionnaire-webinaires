function setupTabs() {
const tabButtons = document.querySelectorAll('.tab-button');
const tabPanels = document.querySelectorAll('.tab-panel');
tabButtons.forEach(button => {
button.addEventListener('click', () => switchTab(button.id));
button.addEventListener('keydown', handleTabKeydown);
});
// Activer le premier onglet par défaut
switchTab('tab-animations');
}
function switchTab(activeTabId) {
const tabButtons = document.querySelectorAll('.tab-button');
const tabPanels = document.querySelectorAll('.tab-panel');
// Désactiver tous les onglets
tabButtons.forEach(button => {
button.classList.remove('active');
button.setAttribute('aria-selected', 'false');
button.setAttribute('tabindex', '-1');
});
tabPanels.forEach(panel => {
panel.classList.add('hidden');
});
// Activer l'onglet sélectionné
const activeButton = document.getElementById(activeTabId);
const panelId = activeButton.getAttribute('aria-controls');
const activePanel = document.getElementById(panelId);
activeButton.classList.add('active');
activeButton.setAttribute('aria-selected', 'true');
activeButton.setAttribute('tabindex', '0');
activePanel.classList.remove('hidden');
}
function handleTabKeydown(e) {
const tabButtons = Array.from(document.querySelectorAll('.tab-button'));
const currentIndex = tabButtons.indexOf(e.target);
switch (e.key) {
case 'ArrowLeft':
e.preventDefault();
const prevIndex = currentIndex > 0 ? currentIndex - 1 : tabButtons.length - 1;
tabButtons[prevIndex].focus();
switchTab(tabButtons[prevIndex].id);
break;
case 'ArrowRight':
e.preventDefault();
const nextIndex = currentIndex < tabButtons.length - 1 ? currentIndex + 1 : 0;
tabButtons[nextIndex].focus();
switchTab(tabButtons[nextIndex].id);
break;
case 'Home':
e.preventDefault();
tabButtons[0].focus();
switchTab(tabButtons[0].id);
break;
case 'End':
e.preventDefault();
tabButtons[tabButtons.length - 1].focus();
switchTab(tabButtons[tabButtons.length - 1].id);
break;
}
}
