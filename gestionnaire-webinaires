    function setupDragDrop() {
        // Drag events for cards
        document.querySelectorAll('[data-bbb-card-id]').forEach(card => {
            card.addEventListener('dragstart', function(e) {
                const id = this.getAttribute('data-bbb-card-id');
                const type = this.getAttribute('data-bbb-type');
                const items = type === 'geste' ? bbbGestes : bbbTools;
                const item = items.find(i => i.id === id);

                draggedItem = { ...item, type: type };
                this.style.opacity = '0.5';
                e.dataTransfer.effectAllowed = 'copy';
                e.dataTransfer.setData('text/plain', 'bbb-card');
                console.log('Drag start:', draggedItem.name);
            });

            card.addEventListener('dragend', function(e) {
                this.style.opacity = '1';
            });
        });

        // Drop zone
        const dropZone = document.getElementById('bbb-drop-zone');
        if (dropZone) {
            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'copy';
                this.classList.add('ring-4', 'ring-green-500');
            });

            dropZone.addEventListener('dragleave', function(e) {
                if (e.target === this) {
                    this.classList.remove('ring-4', 'ring-green-500');
                }
            });

            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                this.classList.remove('ring-4', 'ring-green-500');

                if (draggedItem) {
                    console.log('Drop:', draggedItem.name);

                    if (draggedItem.type === 'geste') {
                        selection.geste = draggedItem;
                    } else {
                        selection.outil = draggedItem;
