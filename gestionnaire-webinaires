                                <div class="font-bold text-base text-slate-800 mb-2 flex items-center gap-2 flex-wrap">
                                    <span class="bg-indigo-100 px-3 py-1 rounded-lg text-sm">${step.geste.icon} ${step.geste.name}</span>
                                    <span class="text-xl">+</span>
                                    <span class="bg-blue-100 px-3 py-1 rounded-lg text-sm">${step.outil.icon} ${step.outil.name}</span>
                                </div>
                                <div class="text-xs text-slate-500">${step.date}</div>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="moveBBBUp(${step.id})" 
                                    class="text-slate-600 hover:bg-slate-100 px-2 py-1 rounded text-lg"
                                    ${idx === 0 ? 'disabled style="opacity:0.3"' : ''}>⬆️</button>
                            <button onclick="moveBBBDown(${step.id})" 
                                    class="text-slate-600 hover:bg-slate-100 px-2 py-1 rounded text-lg"
                                    ${idx === roadmap.length - 1 ? 'disabled style="opacity:0.3"' : ''}>⬇️</button>
                            <button onclick="removeBBBStep(${step.id})" 
                                    class="text-red-600 hover:bg-red-50 px-2 py-1 rounded font-bold text-xl">×</button>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div class="bg-indigo-50 p-3 rounded-lg">
                                <div class="text-xs font-semibold text-indigo-900 mb-1">🎭 Geste :</div>
                                <div class="text-sm text-indigo-800">${step.geste.description}</div>
                            </div>
                            <div class="bg-blue-50 p-3 rounded-lg">
                                <div class="text-xs font-semibold text-blue-900 mb-1">🛠️ Outil :</div>
                                <div class="text-sm text-blue-800">${step.outil.description}</div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-800 mb-2">🔥 Effet produit :</label>
                            <textarea onchange="updateBBBEffet(${step.id}, this.value)"
                                class="w-full px-3 py-2 border-2 border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 resize-none"
                                rows="3"
                                placeholder="Décrivez l'effet sur l'engagement...">${step.effet}</textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-800 mb-2">📝 Note personnelle :</label>
                            <textarea onchange="updateBBBFootnote(${step.id}, this.value)"
                                class="w-full px-3 py-2 border-2 border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 resize-none"
                                rows="2"
                                placeholder="Ajoutez une note...">${step.footnote}</textarea>
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    }

    window.updateBBBEffet = function(id, val) {
        const step = roadmap.find(s => s.id === id);
        if (step) step.effet = val;
    };

    window.updateBBBFootnote = function(id, val) {
        const step = roadmap.find(s => s.id === id);
        if (step) step.footnote = val;
    };

    window.moveBBBUp = function(id) {
        const idx = roadmap.findIndex(s => s.id === id);
        if (idx > 0) {
            [roadmap[idx - 1], roadmap[idx]] = [roadmap[idx], roadmap[idx - 1]];
            updateRoadmapDisplay();
        }
    };

    window.moveBBBDown = function(id) {
        const idx = roadmap.findIndex(s => s.id === id);
        if (idx < roadmap.length - 1) {
            [roadmap[idx], roadmap[idx + 1]] = [roadmap[idx + 1], roadmap[idx]];
            updateRoadmapDisplay();
        }
    };

    window.removeBBBStep = function(id) {
        if (confirm('Supprimer cette étape ?')) {
            roadmap = roadmap.filter(s => s.id !== id);
            updateRoadmapDisplay();
        }
    };

    window.resetBBBRoadmap = function() {
        if (confirm('Réinitialiser tout le parcours ?')) {
            roadmap = [];
            selection = { geste: null, outil: null };
            document.getElementById('bbb-global-reflection').value = '';
            document.querySelectorAll('[data-bbb-card-id]').forEach(c => {
                c.classList.remove('ring-4', 'ring-blue-500', 'ring-green-500', 'ring-offset-2');
            });
            updateRoadmapDisplay();
        }
    };

    window.exportBBBText = function() {
        if (roadmap.length === 0) {
            alert('Parcours vide.');
            return;
        }

        const reflection = document.getElementById('bbb-global-reflection').value;

        let txt = `╔═══════════════════════════════════════════════════════════════╗\n`;
        txt += `║  PARCOURS PÉDAGOGIQUE - EFFETS BBB SUR L'ENGAGEMENT          ║\n`;
        txt += `╚═══════════════════════════════════════════════════════════════╝\n\n`;
        txt += `Date : ${new Date().toLocaleString('fr-FR')}\n`;
        txt += `Étapes : ${roadmap.length}\n\n`;
        txt += `${'═'.repeat(65)}\n\n`;

        roadmap.forEach((step, i) => {
            txt += `ÉTAPE ${i + 1}\n`;
            txt += `${'─'.repeat(65)}\n`;
            txt += `🎭 Geste : ${step.geste.icon} ${step.geste.name}\n`;
            txt += `   ${step.geste.description}\n\n`;
            txt += `🛠️  Outil : ${step.outil.icon} ${step.outil.name}\n`;
            txt += `   ${step.outil.description}\n\n`;
            txt += `🔥 Effet : ${step.effet || '(Non renseigné)'}\n\n`;
            if (step.footnote) txt += `📝 Note : ${step.footnote}\n\n`;
            txt += `\n${'═'.repeat(65)}\n\n`;
        });

        if (reflection) {
            txt += `💭 RÉFLEXION GLOBALE\n`;
            txt += `${'═'.repeat(65)}\n`;
            txt += reflection + '\n';
        }

        const blob = new Blob([txt], {type: 'text/plain;charset=utf-8'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `parcours-bbb-${new Date().toISOString().split('T')[0]}.txt`;
        a.click();
        URL.revokeObjectURL(url);
    };

    window.exportBBBJSON = function() {
        if (roadmap.length === 0) {
            alert('Parcours vide.');
            return;
        }

        const data = {
            titre: 'Parcours Pédagogique BBB',
            date: new Date().toLocaleString('fr-FR'),
            etapes: roadmap.length,
            reflexion: document.getElementById('bbb-global-reflection').value,
            parcours: roadmap.map((s, i) => ({
                numero: i + 1,
                geste: {nom: s.geste.name, icone: s.geste.icon, description: s.geste.description},
                outil: {nom: s.outil.name, icone: s.outil.icon, description: s.outil.description},
                effet: s.effet,
                note: s.footnote,
                date: s.date
            }))
        };

        const json = JSON.stringify(data, null, 2);
        const blob = new Blob([json], {type: 'application/json;charset=utf-8'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `parcours-bbb-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBBBTab);
    } else {
        initBBBTab();
    }

    console.log('✅ BBB Tab with Drag & Drop loaded');
})();

</script>
</body>
</html>
